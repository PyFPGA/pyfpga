set -e

# Prefer Gowin Programmer CLI when loaded; otherwise openFPGALoader.
if command -v programmer_cli >/dev/null 2>&1; then
  programmer_cli --fsFile {{ bitstream }}
else
  openFPGALoader {{ bitstream }}
fi
